# Copiar a .env y cambiar los valores antes de desplegar.
# En Vercel, estas mismas variables se cargan en Settings → Environment Variables.
#
# Base de datos: si se omite, se usa SQLite local. En Vercel debe ser la cadena
# del "Transaction pooler" de Supabase (puerto 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
ADMIN_USUARIO=coordinador
ADMIN_CLAVE=cambia-esta-clave
TOKEN_HORAS=12
QR_VENTANA_SEGUNDOS=30
ZONA_HORARIA=America/Caracas
